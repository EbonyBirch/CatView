{
  "manifest_version": 2,
  "name": "CatView",
  "description": "Concatenated folder view: show messages from the selected folder and its descendants. Cat illustrations by Fiaz jutt via Vecteezy.com.",
  "version": "0.2.1",
  "author": "OpenAI (experimental implementation)",
  "browser_specific_settings": {
    "gecko": {
      "id": "recursive-folder-view-prototype@local",
      "strict_min_version": "128.0"
    }
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "browser_action": {
    "default_title": "CatView: OFF",
    "default_icon": {
      "16": "icons/cat-off-16.png",
      "32": "icons/cat-off-32.png",
      "48": "icons/cat-off-48.png",
      "64": "icons/cat-off-64.png",
      "128": "icons/cat-off-128.png"
    }
  },
  "icons": {
    "32": "icons/cat-off-32.png",
    "64": "icons/cat-off-64.png",
    "128": "icons/cat-off-128.png"
  },
  "experiment_apis": {
    "recursiveView": {
      "schema": "api/schema.json",
      "parent": {
        "scopes": [
          "addon_parent"
        ],
        "paths": [
          [
            "recursiveView"
          ]
        ],
        "script": "api/implementation.js"
      }
    }
  }
}
